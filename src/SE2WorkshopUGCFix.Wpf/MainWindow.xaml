<Window x:Class="SE2WorkshopUGCFix.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
        Title="SE2 Workshop Recovery" Width="1160" Height="820" MinWidth="940" MinHeight="690"
        WindowStartupLocation="CenterScreen" Background="{StaticResource PageBrush}"
        Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="228"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="22,28,22,24">
                <StackPanel DockPanel.Dock="Bottom">
                    <Border Background="#1D2C41" CornerRadius="11" Padding="14">
                        <StackPanel>
                            <TextBlock Text="LOCAL · OWNER-CONTROLLED" Foreground="{StaticResource SuccessBrush}" FontSize="10" FontWeight="SemiBold"/>
                            <TextBlock Text="Steam writes require an explicit confirmation." TextWrapping="Wrap"
                                       Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="v0.6.0 · WPF Preview" Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="11" Margin="6,18,0,0"/>
                </StackPanel>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,42">
                        <Border Background="{StaticResource PrimaryBrush}" Width="42" Height="42" CornerRadius="12">
                            <TextBlock Text="SE2" FontWeight="Bold" Foreground="#0C1623" FontSize="14"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,2,0,0">
                            <TextBlock Text="Workshop" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="RECOVERY" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="WORKSPACE" Style="{StaticResource EyebrowStyle}" Margin="12,0,0,15"/>
                    <Button Content="⌂   Overview" Style="{StaticResource NavButtonStyle}"
                            Background="#283953" Click="Overview_Click"/>
                    <Button Content="▤   Description check" Style="{StaticResource NavButtonStyle}"
                            Click="OpenPreflight_Click"/>
                    <Button Content="◇   Recovery assistant" Style="{StaticResource NavButtonStyle}"
                            Name="NavRecoveryButton" IsEnabled="False" Click="OpenRecovery_Click"/>
                    <Separator Background="{StaticResource StrokeBrush}" Margin="10,25,10,24"/>
                    <TextBlock Text="ABOUT" Style="{StaticResource EyebrowStyle}" Margin="12,0,0,12"/>
                    <TextBlock Text="Space Engineers 2" FontSize="12" Margin="12,0,0,6"
                               Foreground="{StaticResource SecondaryTextBrush}"/>
                    <TextBlock Text="Steam App 1133870" FontSize="11" Margin="12,0,0,0"
                               Foreground="{StaticResource SecondaryTextBrush}"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="65"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="32,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Workshop / Overview" VerticalAlignment="Center"
                               Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
                    <Border Grid.Column="1" Background="#203347" CornerRadius="14" Padding="12,6" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Fill="{StaticResource SuccessBrush}" Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Safe inspection mode" Foreground="{StaticResource TextBrush}" FontSize="11"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="32,30,32,36">
                    <TextBlock Text="WORKSHOP DIAGNOSTICS" Style="{StaticResource EyebrowStyle}"
                               Foreground="{StaticResource PrimaryBrush}"/>
                    <TextBlock Text="Know what’s broken. Fix only what’s safe."
                               FontSize="28" FontWeight="SemiBold" Margin="0,7,0,7" TextWrapping="Wrap"/>
                    <TextBlock Text="Inspect Steam developer metadata, keep original backups, and review every change before applying it."
                               Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,27"/>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="Inspect a Workshop item" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Text="Use a Workshop item ID or its Steam Community URL."
                                       Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="0,5,0,15"/>
                            <TextBlock Text="WORKSHOP ID OR URL" Style="{StaticResource EyebrowStyle}" Margin="0,0,0,8"/>
                            <TextBox Name="WorkshopInput" Style="{StaticResource FormFieldStyle}" Height="47"
                                     TextChanged="WorkshopInput_TextChanged"/>
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Name="CheckButton" Content="Check metadata  →" Style="{StaticResource PrimaryButtonStyle}"
                                        MinWidth="184" Click="CheckButton_Click" Margin="0,0,10,0"/>
                                <Button Name="ProbeButton" Content="Read-only API probe"
                                        Style="{StaticResource BaseButtonStyle}" Click="ProbeButton_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Background="#182A38" Margin="0,0,0,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="{StaticResource SuccessBrush}" CornerRadius="2"/>
                            <StackPanel Grid.Column="1" Margin="18,0,0,0">
                                <TextBlock Name="StatusCaption" Text="Ready for inspection"
                                           Foreground="{StaticResource TextBrush}" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Name="StatusDetail" Text="Start Steam, close SE2 and ModHUB, then check an item."
                                           Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"
                                           Margin="0,5,0,0" FontSize="12"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="Metadata overview" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,5"/>
                            <TextBlock Name="SummaryTitle" Text="No item inspected" Foreground="{StaticResource SecondaryTextBrush}"
                                       TextWrapping="Wrap" FontSize="12" Margin="0,0,0,16"/>
                            <UniformGrid Columns="4">
                                <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10" Margin="0,0,8,0" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="CONDITION" Style="{StaticResource EyebrowStyle}"/>
                                        <TextBlock Name="ConditionValue" Text="Not checked" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10" Margin="0,0,8,0" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="OWNER" Style="{StaticResource EyebrowStyle}"/>
                                        <TextBlock Name="OwnerValue" Text="Unknown" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10" Margin="0,0,8,0" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="UTF-8 BYTES" Style="{StaticResource EyebrowStyle}"/>
                                        <TextBlock Name="BytesValue" Text="— / 5,000" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="SAFE ACTION" Style="{StaticResource EyebrowStyle}"/>
                                        <TextBlock Name="ActionValue" Text="Inspect first" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                            <TextBlock Name="SummaryDetail" Text="The result and recommended next step will appear here."
                                       TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,16,0,18" FontSize="12"/>
                            <WrapPanel>
                                <Button Name="RepairButton" IsEnabled="False" Content="Repair oversized description"
                                        Style="{StaticResource DangerButtonStyle}" Click="RepairButton_Click" Margin="0,0,10,10"/>
                                <Button Name="RecoveryButton" IsEnabled="False" Content="Open recovery assistant"
                                        Style="{StaticResource BaseButtonStyle}" Click="OpenRecovery_Click" Margin="0,0,10,10"/>
                                <Button Name="BackupButton" IsEnabled="False" Content="Open backup folder"
                                        Style="{StaticResource BaseButtonStyle}" Click="BackupButton_Click" Margin="0,0,10,10"/>
                                <Button Name="ReportButton" IsEnabled="False" Content="Copy safe report"
                                        Style="{StaticResource BaseButtonStyle}" Click="ReportButton_Click" Margin="0,0,0,10"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Expander Header="Activity and diagnostics" IsExpanded="False" Foreground="{StaticResource TextBrush}"
                              Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource StrokeBrush}"
                              BorderThickness="1" Padding="18" Margin="0,0,0,20">
                        <TextBox Name="ActivityLog" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"
                                 Height="136" Margin="0,12,0,0" Style="{StaticResource FormFieldStyle}"/>
                    </Expander>
                    <TextBlock Text="Developer metadata only. No changes to public Workshop descriptions, mod files, thumbnails or saved worlds."
                               Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
